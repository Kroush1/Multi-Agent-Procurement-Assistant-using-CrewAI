{% set cur = company.currency %}
{% macro bullets(items, empty) %}
{% if items %}<ul>{% for item in items %}<li dir="auto">{{ item }}</li>{% endfor %}</ul>
{% else %}<p class="muted">{{ empty }}</p>{% endif %}
{% endmacro %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Procurement report: {{ request.product }}</title>
<style>
:root {
  color-scheme: light;
  --page: #f4f4f1; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --line: #e1e0d9;
  --accent: #2a78d6; --good: #006300; --good-bg: #e6f3e6; --warn-bg: #fdf3d9;
}
@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
    --page: #121211; --surface: #1a1a19; --ink: #f0efec; --ink-2: #c3c2b7; --line: #2c2c2a;
    --accent: #3987e5; --good: #0ca30c; --good-bg: #12260f; --warn-bg: #322710;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--page); color: var(--ink);
  font: 16px/1.55 "Segoe UI", system-ui, -apple-system, "Noto Sans Arabic", sans-serif; }
main { max-width: 1080px; margin: 0 auto; padding: 32px 20px 56px; }
h1 { font-size: 30px; line-height: 1.2; margin: 0 0 6px; text-wrap: balance; }
h2 { font-size: 20px; margin: 40px 0 12px; }
h3 { font-size: 16px; margin: 0 0 4px; }
p { margin: 0 0 10px; max-width: 75ch; }
ul { margin: 0; padding-inline-start: 20px; }
li { margin-bottom: 4px; max-width: 75ch; }
a { color: var(--accent); overflow-wrap: anywhere; }
.muted { color: var(--ink-2); }
.small { font-size: 14px; }
.demo { background: var(--warn-bg); padding: 12px 16px; border-radius: 8px; margin-bottom: 24px; }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 20px; }
.pick { border-inline-start: 5px solid var(--good); margin-top: 24px; }
.pick .title { font-size: 20px; font-weight: 600; }
.facts { display: flex; flex-wrap: wrap; gap: 12px 36px; margin: 14px 0; }
.facts dt { font-size: 13px; color: var(--ink-2); }
.facts dd { margin: 0; font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
.scroll { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
th, td { padding: 10px 12px; text-align: start; vertical-align: top; border-bottom: 1px solid var(--line); }
tr:last-child td { border-bottom: 0; }
th { color: var(--ink-2); font-weight: 600; white-space: nowrap; }
td.num, th.num { text-align: end; font-variant-numeric: tabular-nums; white-space: nowrap; }
td.name { min-width: 200px; }
tr.best td { background: var(--good-bg); }
.tag { white-space: nowrap; font-weight: 600; }
.bars { display: grid; gap: 12px; }
.bar { display: grid; grid-template-columns: minmax(90px, 28%) 1fr; gap: 12px; align-items: center;
  position: relative; }
.bar .label { font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.track { display: flex; align-items: center; gap: 8px; border-inline-start: 1px solid var(--line);
  padding-inline-end: 76px; }
.fill { height: 18px; min-width: 2px; background: var(--accent); border-radius: 0 4px 4px 0; }
.val { font-size: 14px; white-space: nowrap; font-variant-numeric: tabular-nums; margin-inline-end: -76px; }
.tip { display: none; position: absolute; inset-inline-start: 30%; bottom: 100%; z-index: 2;
  max-width: 320px; background: var(--ink); color: var(--page); border-radius: 6px;
  padding: 8px 12px; font-size: 13px; }
.bar:hover .tip, .bar:focus .tip { display: block; }
.bar:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
.cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
footer { margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); }
@media (max-width: 560px) { .bar { grid-template-columns: 1fr; gap: 4px; } }
@media print {
  .card, .scroll, tr { break-inside: avoid; }
  .fill, tr.best td { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
}
</style>
</head>
<body>
<main>
{% if state.demo %}
<div class="demo"><strong>Demo data.</strong> Every product, website and price below is
invented to show how the system works. Do not use this report for a purchase.</div>
{% endif %}

<header>
  <h1 dir="auto">Procurement report: {{ request.product }}</h1>
  <p class="muted">Prepared for {{ company.name }}, {{ generated }}</p>
</header>

<section class="card pick">
{% if best %}
  <h3 class="muted">Recommended purchase</h3>
  <div class="title" dir="auto"><a href="{{ best.product.url }}" rel="noopener noreferrer">{{ best.product.title }}</a></div>
  <dl class="facts">
    <div><dt>Unit price</dt><dd>{{ best.unit_price|money }} {{ cur }}</dd></div>
    <div><dt>Order of {{ request.quantity }}</dt><dd>{{ (best.unit_price * request.quantity)|money }} {{ cur }}</dd></div>
    <div><dt>Total score</dt><dd>{{ "%.1f"|format(best.total_score) }} / 100</dd></div>
    <div><dt>Website</dt><dd>{{ best.product.url|domain }}</dd></div>
    <div><dt>Warranty</dt><dd dir="auto">{{ best.product.warranty or "Not stated" }}</dd></div>
  </dl>
{% else %}
  <div class="title">No offer qualifies</div>
{% endif %}
  <p dir="auto">{{ content.recommendation }}</p>
</section>

<h2>Executive summary</h2>
<p dir="auto">{{ content.executive_summary }}</p>

<h2>The request</h2>
<dl class="facts">
  <div><dt>Quantity</dt><dd>{{ request.quantity }}</dd></div>
  <div><dt>Unit budget</dt><dd>{% if request.max_unit_price %}{{ request.max_unit_price|money }} {{ cur }}{% else %}No limit{% endif %}</dd></div>
  <div><dt>Offers compared</dt><dd>{{ ranking|length }}</dd></div>
  <div><dt>Websites</dt><dd>{{ websites|length }}</dd></div>
</dl>

<h2>Market overview</h2>
<p dir="auto">{{ content.market_overview }}</p>

{% if chart %}
<h2>Unit price by offer ({{ cur }})</h2>
<div class="card bars" role="list">
{% for r in chart %}
  <div class="bar" role="listitem" tabindex="0">
    <span class="label" dir="auto">{{ r.product.title }}<br><span class="muted">{{ r.product.url|domain }}</span></span>
    <span class="track">
      <span class="fill" style="width: {{ '%.1f'|format(100 * r.unit_price / max_price) }}%"></span>
      <span class="val">{{ r.unit_price|money }}</span>
    </span>
    <span class="tip"><strong>{{ r.unit_price|money }} {{ cur }}</strong><br>{{ r.product.title }}<br>{{ r.product.url|domain }}, score {{ "%.1f"|format(r.total_score) }}</span>
  </div>
{% endfor %}
</div>
{% endif %}

<h2>Ranking</h2>
<div class="scroll">
<table>
  <thead><tr>
    <th class="num">Rank</th><th>Product</th><th>Website</th><th class="num">Unit price ({{ cur }})</th>
    <th class="num">Price</th><th class="num">Specs</th><th class="num">Value</th><th class="num">Total</th><th>Status</th>
  </tr></thead>
  <tbody>
  {% for r in ranking %}
  <tr{% if best and r.product.id == best.product.id %} class="best"{% endif %}>
    <td class="num">{{ r.rank or "–" }}</td>
    <td class="name" dir="auto"><a href="{{ r.product.url }}" rel="noopener noreferrer">{{ r.product.title }}</a></td>
    <td>{{ r.product.url|domain }}</td>
    <td class="num">{% if r.unit_price %}{{ r.unit_price|money }}{% elif r.product.price %}{{ r.product.price|money }} {{ r.product.currency or "" }}{% else %}–{% endif %}</td>
    <td class="num">{{ "%.1f"|format(r.price_score) if r.unit_price else "–" }}</td>
    <td class="num">{{ "%.1f"|format(r.spec_score) }}</td>
    <td class="num">{{ "%.1f"|format(r.value_score) if r.unit_price else "–" }}</td>
    <td class="num"><strong>{{ "%.1f"|format(r.total_score) if r.unit_price else "–" }}</strong></td>
    <td><span class="tag">{{ "✓ Eligible" if r.eligible else "✕ Not eligible" }}</span>
      {% for issue in r.issues %}<br><span class="muted" dir="auto">{{ issue }}</span>{% endfor %}</td>
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>
<p class="muted small" style="margin-top: 10px">Scores run from 0 to 100. Total = {{ "%.0f"|format(100 * weights.price) }}% price (cheapest eligible ÷ this price)
+ {{ "%.0f"|format(100 * weights.specs) }}% specs (share of requirements met, must-haves count double)
+ {{ "%.0f"|format(100 * weights.value) }}% value (specs per {{ cur }}, relative to the best eligible offer).</p>

<h2>Requirement check</h2>
<div class="scroll">
<table>
  <thead><tr><th>Requirement</th>{% for r in ranking %}<th dir="auto" style="white-space: normal; min-width: 130px">{{ r.product.title }}<br><span class="small" style="font-weight: 400">{{ r.product.url|domain }}</span></th>{% endfor %}</tr></thead>
  <tbody>
  {% for req in state.requirements %}
  <tr>
    <td class="name" dir="auto">{{ req.text }}<br><span class="muted small">{{ "Must have" if req.must_have else "Nice to have" }}</span></td>
    {% for r in ranking %}
    {% for c in r.assessment.checks if c.requirement_id == req.id %}
    <td><span class="tag">{{ {"met": "✓ Met", "partial": "◐ Partial", "unmet": "✕ Not met", "unknown": "? Unknown"}[c.status] }}</span><br><span class="muted" dir="auto">{{ c.evidence }}</span></td>
    {% endfor %}
    {% endfor %}
  </tr>
  {% endfor %}
  </tbody>
</table>
</div>

<h2>Comparison notes</h2>
{{ bullets(content.comparison_notes, "None.") }}

<h2>Product details</h2>
<div class="cols">
{% for r in ranking %}
  <div class="card">
    <h3 dir="auto">{{ r.product.title }}</h3>
    <p class="muted small">{{ r.product.seller or r.product.url|domain }},
      {{ "in stock" if r.product.in_stock else ("out of stock" if r.product.in_stock is false else "stock not stated") }},
      warranty: {{ r.product.warranty or "not stated" }}</p>
    {% if r.assessment.pros %}<strong>Pros</strong>{{ bullets(r.assessment.pros, "") }}{% endif %}
    {% if r.assessment.cons %}<strong>Cons</strong>{{ bullets(r.assessment.cons, "") }}{% endif %}
    {% if r.product.specs %}
    <details><summary>All specifications</summary>
      <ul>{% for s in r.product.specs %}<li dir="auto">{{ s.name }}: {{ s.value }}</li>{% endfor %}</ul>
    </details>
    {% endif %}
  </div>
{% endfor %}
</div>

<div class="cols">
  <section><h2>Risks</h2>{{ bullets(content.risks, "None identified.") }}</section>
  <section><h2>Next steps</h2>{{ bullets(content.next_steps, "None.") }}</section>
</div>

{% if state.warnings %}
<h2>Data quality notes</h2>
{{ bullets(state.warnings, "") }}
{% endif %}

<footer class="small muted">
  <p>Sources read for this report. Prices and stock change; confirm them before ordering.</p>
  <ul>
  {% for r in ranking %}
    <li><a href="{{ r.product.url }}" rel="noopener noreferrer">{{ r.product.url }}</a> ({{ page_of(r.product).tool }})</li>
  {% endfor %}
  </ul>
  <p style="margin-top: 12px">Searches: {{ state.queries|join("; ") }}</p>
</footer>
</main>
</body>
</html>
